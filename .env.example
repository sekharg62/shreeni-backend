PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# PostgreSQL connection used by Prisma (Supabase pooler shown as example).
# Runtime connection (transaction-mode pooler, pgbouncer):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection used for migrations (session-mode pooler):
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
