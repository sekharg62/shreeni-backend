PORT=8080
NODE_ENV=development

# This API's own public base URL (host URL)
APP_URL=http://localhost:8080

# Comma-separated origins allowed to call this API (storefront, admin)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Auth
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d
# Storefront customers stay signed in longer (default 7d)
CUSTOMER_JWT_EXPIRES_IN=7d

# PostgreSQL connection used by Prisma (Supabase pooler shown as example).
# Runtime connection (transaction-mode pooler, pgbouncer):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection used for migrations (session-mode pooler):
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# AWS S3 — product/category/banner images (IAM user with s3:PutObject + s3:DeleteObject)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
