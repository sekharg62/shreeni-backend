PORT=8080
NODE_ENV=development

# This API's own public base URL (host URL)
APP_URL=http://localhost:8080

# Comma-separated origins allowed to call this API (storefront, admin)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Auth
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# PostgreSQL connection used by Prisma (Supabase pooler shown as example).
# Runtime connection (transaction-mode pooler, pgbouncer):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection used for migrations (session-mode pooler):
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
